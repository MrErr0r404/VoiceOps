# ============================================
# VoiceOps Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/voiceops

# --- Rime TTS ---
RIME_API_KEY=
RIME_MODEL=mist
RIME_SPEAKER=cove
RIME_LANGUAGE=en
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLE_RATE=22050

# --- Speech-to-Text ---
# Options: browser (Web Speech API, default), deepgram
STT_PROVIDER=browser
STT_API_KEY=

# --- LLM ---
# Options: openai, demo (simulated responses, no key needed)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Tool Simulation ---
SIMULATED_TOOL_DELAY_MS=5000

# --- Demo Mode ---
DEMO_MODE=true
